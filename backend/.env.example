# Backend Server Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated origins, or * for all)
# Example for production: https://essorcompliance.com,https://www.essorcompliance.com
CORS_ORIGIN=*

# Gemini AI API Key (for /api/ai routes)
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Hostinger MySQL Database Configuration (Optional - falls back to .data/essor_store.json)
# ---------------------------------------------------------------------------
# DB_HOST: Usually 'localhost' on VPS/Cloud, or remote host IP
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

