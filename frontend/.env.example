# ==============================================================================
# ESSOR Compliance Solutions - Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
# - In Local Development: Leave empty to automatically use Vite dev proxy to http://localhost:5000
# - In Production (Vercel / Netlify / Hostinger): Set to your backend subdomain (e.g., https://api.essorcompliance.com)
VITE_API_BASE_URL=

# Backend Proxy URL (used by Vite dev server during local npm run dev)
VITE_BACKEND_PROXY_URL=http://localhost:5000

