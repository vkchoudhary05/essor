# Server Configuration
PORT=3000
NODE_ENV=development

# AI Studio Server-Side Gemini API Key
GEMINI_API_KEY=

# Vite Dev Server Configuration
DISABLE_HMR=false

# ---------------------------------------------------------------------------
# Hostinger MySQL Database Configuration (Set these to activate MySQL)
# ---------------------------------------------------------------------------
# DB_HOST: Usually 'localhost' if running Node directly on Hostinger VPS / Cloud,
#          or Hostinger server hostname / IP (e.g., sqlXXX.main-hosting.eu or srvXXX.hstgr.io)
DB_HOST=
DB_PORT=3306
# DB_USER: Your Hostinger MySQL Username (e.g., u123456789_essor)
DB_USER=
# DB_PASSWORD: Your Hostinger MySQL Database User Password
DB_PASSWORD=
# DB_NAME: Your Hostinger MySQL Database Name (e.g., u123456789_essor_db)
DB_NAME=

